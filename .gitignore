## A streamlined .gitignore for a polyglot project
## covering .NET, Rust, C/CMake, and common editor/OS artifacts.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
tools/terminalizer-bootstrap/
tools/terminalizer-runtime/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/
coverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Local environment files (secrets)
.env
.env.*
!.env.example
node_modules/

# Local SQLite runtime files
qsoripper.db*
.playwright-mcp/

# Rust
target/
Cargo.lock

# C / CMake
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.o
*.a
*.so
*.dylib

# Stress test reports
stress-report.html

# Experimental audio test artifacts
*.mp3
*.wav


# Syncthing-managed local data, captures, corpora, and runtime databases.
data/*
!data/contest-calendar/
data/contest-calendar/*
!data/contest-calendar/contest-details.json

# cw-decoder stress-test generated audio (large, regenerable via stress-gen.ps1)
experiments/cw-decoder/bench-runs/
experiments/cw-decoder/captures/

# Local cw-decoder bench reports
experiments/cw-decoder/kaggle_report_*.json
experiments/cw-decoder/kaggle_minisuite_report.json
data/cw-samples/training-set-a/_benchmark_current.json
